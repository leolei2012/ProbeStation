{
  "name": "probestation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "tsx scripts/test-safe.ts",
    "audit:history-breaks": "tsx scripts/audit-history-breaks.ts",
    "audit:history-evidence": "tsx scripts/audit-history-evidence.ts --synthetic",
    "preview:picker": "tsx scripts/preview-register-picker.ts",
    "preview:settings": "tsx scripts/preview-register-picker.ts --settings",
    "preview:comparison": "tsx scripts/preview-register-picker.ts --comparison",
    "preview:diagnostics": "tsx scripts/preview-register-picker.ts --diagnostics",
    "preview:backup": "tsx scripts/preview-register-picker.ts --backup",
    "preview:live-filter": "tsx scripts/preview-register-picker.ts --live-filter",
    "preview:live-snapshot": "tsx scripts/preview-register-picker.ts --live-snapshot",
    "preview:device-issues": "tsx scripts/preview-register-picker.ts --device-issues",
    "preview:communication": "tsx scripts/preview-register-picker.ts --communication",
    "preview:raw-frames": "tsx scripts/preview-register-picker.ts --raw-frames",
    "preview:diagnostics-cleanup": "tsx scripts/preview-register-picker.ts --diagnostics-cleanup",
    "preview:global-retention": "tsx scripts/preview-register-picker.ts --global-retention",
    "preview:settings-loading": "tsx scripts/preview-register-picker.ts --settings-loading",
    "preview:config-loading": "tsx scripts/preview-register-picker.ts --config-loading",
    "preview:device-draft": "tsx scripts/preview-register-picker.ts --device-draft",
    "preview:markdown": "tsx scripts/preview-register-picker.ts --markdown",
    "preview:curve-selection": "tsx scripts/preview-register-picker.ts --curve-selection",
    "preview:history-context": "tsx scripts/preview-register-picker.ts --history-context",
    "preview:alarm-history": "tsx scripts/preview-register-picker.ts --alarm-history",
    "preview:alarm-rules": "tsx scripts/preview-register-picker.ts --alarm-rules",
    "preview:persistence": "tsx scripts/preview-register-picker.ts --persistence",
    "preview:retention": "tsx scripts/preview-register-picker.ts --retention",
    "preview:attachments": "tsx scripts/preview-register-picker.ts --attachments",
    "preview:logs": "tsx scripts/preview-register-picker.ts --logs",
    "preview:log-cleanup": "tsx scripts/preview-register-picker.ts --log-cleanup",
    "preview:query-memory": "tsx scripts/preview-register-picker.ts --query-memory",
    "preview:time-range": "tsx scripts/preview-register-picker.ts --time-range",
    "audit:export-version": "tsx scripts/audit-history-export-version.ts --mock",
    "audit:export-entry": "tsx scripts/audit-export-entry.ts --memory",
    "audit:sink-condition": "tsx scripts/audit-sink-condition.ts --memory",
    "diagnose:points": "tsx scripts/diagnose-points.ts",
    "test:edition": "npm run build:web && tsx scripts/offline-test-app.ts",
    "typecheck:web": "tsc -p tsconfig.web.json",
    "typecheck:services": "tsc -p tsconfig.services.json",
    "check:web-bundle": "tsx scripts/check-web-bundle.ts",
    "check": "npm run typecheck:web && npm run typecheck:services && npm run build:web && npm run check:web-bundle && npm test",
    "dev": "npm run dev --workspace @probebench/cli",
    "build:web": "npm run build --workspace @probebench/web",
    "start": "npm run build:web && tsx apps/cli/src/main.ts"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "tsx": "^4.19.0",
    "@types/node": "^22.0.0"
  }
}
