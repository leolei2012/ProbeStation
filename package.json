{
  "name": "probestation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "tsx scripts/test-safe.ts",
    "test:edition": "npm run build:web && tsx scripts/offline-test-app.ts",
    "typecheck:web": "tsc -p tsconfig.web.json",
    "typecheck:services": "tsc -p tsconfig.services.json",
    "check": "npm run typecheck:web && npm run typecheck:services && npm run build:web && npm test",
    "dev": "npm run dev --workspace @probebench/cli",
    "build:web": "npm run build --workspace @probebench/web",
    "start": "npm run build:web && tsx apps/cli/src/main.ts"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "tsx": "^4.19.0",
    "@types/node": "^22.0.0"
  }
}
